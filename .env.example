# --- PostgreSQL ---
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv_dev_pw_change_me
POSTGRES_DB=cctv_monitoring
POSTGRES_PORT=5432

# --- MinIO ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_pw_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- NATS ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222

