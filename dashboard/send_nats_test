import asyncio
import json
from nats import NATS

async def main():
    nc = NATS()
    await nc.connect("127.0.0.1:4222")
    msg = {"message": "hello world !"}
    await nc.publish("cs.vision.control.detected", json.dumps(msg).encode("utf-8"))
    await nc.flush()
    await nc.close()

asyncio.run(main())
